project_id             = "ceo-dev123"
region                 = "us-central1"
deployment_environment = "development"

billing_api_service_name         = "superapp-billing-api"
billing_api_service_account_name = "superapp-billing-sa"

# Container Image
billing_api_image = "us-central1-docker.pkg.dev/ceo-dev123/ceo-agent-repo/superapp-billing-api:latest"

# Secret Manager IDs
billing_api_stripe_secret_key_secret_id     = "stripe-secret-key"
billing_api_stripe_webhook_signing_secret_id = "" # Leave empty initially until secret is created in Secret Manager

# Reconciliation Schedule
billing_reconciliation_enabled = true
billing_reconciliation_schedule = "0 * * * *"

# Shared Firestore Collections
firestore_customer_wallets_collection                   = "customer_wallets_v3"
firestore_wallet_transactions_collection                = "wallet_transactions_v3"
firestore_customer_billing_periods_collection           = "customer_billing_periods_v3"
firestore_customer_billing_accounts_collection          = "customer_billing_accounts_v3"
firestore_stripe_webhook_events_collection              = "stripe_webhook_events_v3"
firestore_subscription_cancellation_requests_collection = "subscription_cancellation_requests_v3"

# Allowed CORS Origins
billing_api_allowed_origins = ["https://ceoappdev.flutterflow.app"]

# Stripe Checkout Redirect URLs
billing_api_checkout_success_url = "https://app.example.com/billing/success?session_id={CHECKOUT_SESSION_ID}"
billing_api_checkout_cancel_url  = "https://app.example.com/billing/cancel"
